            local camera = workspace.CurrentCamera
            if not camera then return end
            local intensity = Options.Fun_DrunkIntensity.Value / 10
            drunkTime = drunkTime + dt
            local rollAmp   = math.rad(7   * intensity)
            local pitchAmp  = math.rad(3.5 * intensity)
            local roll  = rollAmp  * math.sin(drunkTime * 0.6  * math.pi * 2)
            local pitch = pitchAmp * math.sin(drunkTime * 0.85 * math.pi * 2 + 1.3)
            camera.CFrame = camera.CFrame * CFrame.Angles(pitch, 0, roll)
            drunkBlur.Size = math.clamp(8 * intensity * ((math.sin(drunkTime * 1.1 * math.pi * 2) + 1) / 2), 0, 28)
            local tintT = (math.sin(drunkTime * 0.35 * math.pi * 2) + 1) / 2
            drunkColorCorrect.TintColor = Color3.fromRGB(255, math.floor(210 + 45 * tintT), math.floor(190 + 65 * (1 - tintT)))
            drunkColorCorrect.Saturation = -0.2 * intensity * (math.sin(drunkTime * 0.7) + 1)
        end)

        onCleanup(function()
            pcall(function() drunkBlur:Destroy() end)
