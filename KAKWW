    connect(UserInputService.InputBegan,function(input)
        if UserInputService:GetFocusedTextBox() or not inputMatchesBind(input,"Keybind_GameDash") then return end
        local humanoid=getHumanoid()
        local root=getRoot()
        local camera=workspace.CurrentCamera
        if not humanoid or not root or not camera then return end
        local look=Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
        if look.Magnitude<0.01 then look=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z) end
        look=look.Unit
        local kind="front"
        local direction=look
        local move=humanoid.MoveDirection
        if move.Magnitude>0.1 then
            direction=Vector3.new(move.X,0,move.Z).Unit
            local forwardDot=direction:Dot(look)
            if forwardDot>0.5 then kind="front" elseif forwardDot<-0.5 then kind="back" else kind="side" end
        end
        local now=os.clock()
        local boostAllowed=true
        if kind=="side" then
            cooldowns.side=now+SIDE_COOLDOWN
        elseif now>=cooldowns.frontBack then
            cooldowns.frontBack=now+FRONT_BACK_COOLDOWN
        else
            boostAllowed=false
        end
        if not boostAllowed or not Toggles.Dash_Enabled.Value or isRagdolled(humanoid) then return end
        local boost = (tonumber(Options.Dash_FrontBoost.Value) or 25)
        if kind=="side" then boost=(tonumber(Options.Dash_SideBoost.Value) or 40)
        elseif kind=="back" then boost=(tonumber(Options.Dash_BackBoost.Value) or 25) end
        dashing={
            kind=kind,
            direction=direction,
            speed=boost,
            endsAt=now+(tonumber(Options.Dash_Duration.Value) or 250)/1000,
        }
    end)
    connect(RunService.Heartbeat,function(dt)
        if not dashing then return end
        local root=getRoot()
        if not root or os.clock()>=dashing.endsAt or isRagdolled(getHumanoid()) then dashing=nil; return end
        local direction=dashing.direction
        if dashing.kind=="front" then
            local camera=workspace.CurrentCamera
            if camera then
                local look=Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
                if look.Magnitude>0.01 then direction=look.Unit end
            end
        end
        root.CFrame=root.CFrame+direction*(dashing.speed*dt)
    end)

