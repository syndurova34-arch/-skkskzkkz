do
    local PlayerBox=addGroup(MusicTab,"Left","Music Player","music")
    local ControlBox=addGroup(MusicTab,"Right","Controls","sliders-horizontal")
    local PlaylistBox=addGroup(MusicTab,"Right","Playlist","list-music")

    local playlist={}
    for _,track in MUSIC_TRACKS do
        table.insert(playlist,{name=track.name,ids=track.ids})
    end
    local function trackNames()
        local names={}
        for _,track in playlist do table.insert(names,track.name) end
        return names
    end

    local sound=Instance.new("Sound")
    sound.Name="ChillhubMusic"
    sound.Volume=0.5
    sound.Parent=SoundService

    local currentIndex=0
    local playToken=0
    local nowPlaying=PlayerBox:AddLabel({ Text="Now Playing: nothing", DoesWrap=true })
    local function setStatus(text) nowPlaying:SetText(text) end

    PlayerBox:AddDropdown("Music_Track",{ Values=trackNames(), Default=1, Text="Track" })
    local function selectedIndex()
        local value=Options.Music_Track.Value
        for i,track in playlist do
            if track.name==value then return i end
        end
        return 1
    end
    local function refreshDropdown()
        pcall(function() Options.Music_Track:SetValues(trackNames()) end)
    end
    local function applySource(track,candidate)
        if track.file then
            local ok,asset=pcall(function() return getcustomasset(track.file) end)
            if not ok or not asset then return false end
            sound.SoundId=asset
        else
            sound.SoundId="rbxassetid://"..candidate
        end
        return true
    end
    local function playTrack(index)
        local track=playlist[index]
        if not track then return end
        currentIndex=index
        playToken+=1
        local token=playToken
        setStatus("Loading: "..track.name.."...")
        task.spawn(function()
            local candidates=track.file and {"file"} or track.ids
            for _,candidate in candidates do
                if token~=playToken then return end
                sound:Stop()
                if applySource(track,candidate) then
                    sound.TimePosition=0
                    sound:Play()
                    local waited=0
                    while token==playToken and not sound.IsLoaded and waited<5 do
                        task.wait(0.1)
                        waited+=0.1
                    end
                    if token~=playToken then return end
                    if sound.IsLoaded and sound.TimeLength>0 then
                        setStatus("Now Playing: "..track.name)
                        return
                    end
                end
            end
            if token==playToken then
                sound:Stop()
                setStatus("Couldn't load: "..track.name)
                Library:Notify("Couldn't play "..track.name..". Its audio IDs may be private or removed.",7)
            end
        end)
    end
    local function nextIndex(step)
        if #playlist==0 then return 0 end
        if Toggles.Music_Shuffle.Value and #playlist>1 then
            local pick=currentIndex
            while pick==currentIndex do pick=math.random(1,#playlist) end
            return pick
        end
        return ((currentIndex-1+step)%#playlist)+1
    end
    local playButton=PlayerBox:AddButton({ Text="Play", Func=function() playTrack(selectedIndex()) end })
    playButton:AddButton({ Text="Pause / Resume", Func=function()
        if sound.IsPaused then sound:Resume() elseif sound.IsPlaying then sound:Pause() end
    end })
    local prevButton=PlayerBox:AddButton({ Text="Previous", Func=function() playTrack(nextIndex(-1)) end })
    prevButton:AddButton({ Text="Next", Func=function() playTrack(nextIndex(1)) end })
    PlayerBox:AddButton({ Text="Stop", Func=function() playToken+=1; sound:Stop(); setStatus("Now Playing: nothing") end })
    PlayerBox:AddLabel({ Text="Only you can hear this. Paste custom audio IDs in the playlist below.", DoesWrap=true })

    ControlBox:AddSlider("Music_Volume",{ Text="Volume",         Min=0,   Max=100, Default=50, Rounding=0, Suffix="%", Callback=function(v) sound.Volume=v/100 end })
    ControlBox:AddSlider("Music_Speed", { Text="Playback Speed", Min=0.5, Max=2,   Default=1,  Rounding=2, Suffix="x", Callback=function(v) sound.PlaybackSpeed=v end })
    ControlBox:AddToggle("Music_Loop",    { Text="Loop Track",    Default=false, Callback=function(v) sound.Looped=v end })
    ControlBox:AddToggle("Music_Shuffle", { Text="Shuffle",       Default=false })
    ControlBox:AddToggle("Music_AutoNext",{ Text="Auto Play Next",Default=true })
    connect(sound.Ended,function()
        if Toggles.Music_AutoNext.Value then playTrack(nextIndex(1))
        else setStatus("Finished") end
    end)

    local function formatTime(seconds)
        return ("%d:%02d"):format(math.floor(seconds/60),math.floor(seconds%60))
    end
    task.spawn(function()
        while not unloaded do
            local track=playlist[currentIndex]
            if track and sound.IsLoaded and sound.TimeLength>0 and (sound.IsPlaying or sound.IsPaused) then
                local prefix=sound.IsPaused and "Paused: " or "Now Playing: "
                setStatus(prefix..track.name.."  ("..formatTime(sound.TimePosition).." / "..formatTime(sound.TimeLength)..")")
            end
            task.wait(0.5)
        end
    end)

    PlaylistBox:AddInput("Music_CustomId",{ Text="Custom Audio ID", Default="", Numeric=false, Finished=false, Placeholder="paste a Roblox audio ID" })
    PlaylistBox:AddButton({ Text="Add To Playlist", Func=function()
        local id=tostring(Options.Music_CustomId.Value or ""):gsub("%D","")
        if id=="" then Library:Notify("Paste an audio ID first",3); return end
        table.insert(playlist,{name="Custom "..id,ids={id}})
        refreshDropdown()
        Library:Notify("Added Custom "..id.." to the playlist",3)
    end })

    local MUSIC_FOLDER="ChillhubTSB/music"
    PlaylistBox:AddButton({ Text="Scan Local Music Folder", Func=function()
        if type(listfiles)~="function" or type(getcustomasset)~="function" then
            Library:Notify("Your executor doesn't support listfiles / getcustomasset",5)
            return
        end
        pcall(function()
            if type(makefolder)=="function" and type(isfolder)=="function" then
                if not isfolder("ChillhubTSB") then makefolder("ChillhubTSB") end
                if not isfolder(MUSIC_FOLDER) then makefolder(MUSIC_FOLDER) end
            end
        end)
        local ok,files=pcall(listfiles,MUSIC_FOLDER)
        if not ok then Library:Notify("Put .mp3 / .ogg files in workspace/"..MUSIC_FOLDER.." then scan again",6); return end
        local added=0
        for _,path in files do
            local lower=path:lower()
            if lower:match("%.mp3$") or lower:match("%.ogg$") then
                local exists=false
                for _,track in playlist do
                    if track.file==path then exists=true end
                end
                if not exists then
                    local fileName=path:match("([^/\\]+)$") or path
                    table.insert(playlist,{name="File: "..fileName,file=path})
                    added+=1
                end
            end
        end
        refreshDropdown()
        if added>0 then
            Library:Notify("Added "..added.." local file(s)",4)
        else
            Library:Notify("No new .mp3 / .ogg files in workspace/"..MUSIC_FOLDER,5)
        end
    end })
    onCleanup(function() playToken+=1; sound:Destroy() end)
end

