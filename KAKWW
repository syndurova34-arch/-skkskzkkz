do
    local PerfBox = addGroup(VisualsTab, "Left", "Performance & Visibility", "gauge")
    local GREY_SKY_IMAGE = "rbxasset://textures/grey.png"
    local originalGlobalShadows = Lighting.GlobalShadows
    local originalSky  = Lighting:FindFirstChildOfClass("Sky")
    local skyClone     = originalSky and originalSky:Clone()
    local greySky      = nil
    local lowQualityOn = false
    local disabledEffects = {}; local disabledFx = {}

    local function isFx(obj)
        return (obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")) and obj.Name ~= "ChillTrail"
    end
    local function disableFx(obj, record)
        if obj.Enabled then
            if record then disabledFx[obj] = true end
            obj.Enabled = false
        end
    end
    local function applyGreySky()
        if not greySky then
            greySky = Instance.new("Sky")
            greySky.Name = "LowQualityGreySky"
            for _, face in {"Bk","Dn","Ft","Lf","Rt","Up"} do greySky["Skybox"..face] = GREY_SKY_IMAGE end
        end
        local current = Lighting:FindFirstChildOfClass("Sky")
        if current and current ~= greySky then current:Destroy() end
        greySky.Parent = Lighting
    end
    local function setLowQuality(on)
        lowQualityOn = on
        if on then
            Lighting.GlobalShadows = false
            applyGreySky()
        else
            Lighting.GlobalShadows = originalGlobalShadows
            if greySky then greySky.Parent = nil end
            if skyClone and not Lighting:FindFirstChildOfClass("Sky") then skyClone:Clone().Parent = Lighting end
        end
        for _, effect in Lighting:GetChildren() do
            if effect:IsA("PostEffect") then
                if on then
                    if effect.Enabled then disabledEffects[effect] = true; effect.Enabled = false end
                elseif disabledEffects[effect] then
                    effect.Enabled = true; disabledEffects[effect] = nil
                end
            end
        end
        for _, obj in workspace:GetDescendants() do
            if isFx(obj) then
                if on then disableFx(obj, true)
                elseif disabledFx[obj] then obj.Enabled = true; disabledFx[obj] = nil end
            end
        end
    end
    connect(workspace.DescendantAdded, function(obj)
        if lowQualityOn and isFx(obj) then task.defer(disableFx, obj, false) end
    end)

    PerfBox:AddToggle("LowQuality_Enabled", { Text = "Low Quality", Default = false, Callback = setLowQuality })

    local savedLighting = nil
    PerfBox:AddToggle("Fullbright_Enabled", { Text = "Fullbright", Default = false, Callback = function(on)
        if on then
            savedLighting = {
                Brightness = Lighting.Brightness,
                ClockTime = Lighting.ClockTime,
                Ambient = Lighting.Ambient,
                OutdoorAmbient = Lighting.OutdoorAmbient,
                FogEnd = Lighting.FogEnd,
                GlobalShadows = Lighting.GlobalShadows,
            }
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.Ambient = Color3.new(1,1,1)
            Lighting.OutdoorAmbient = Color3.new(1,1,1)
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
        elseif savedLighting then
            for prop, value in savedLighting do Lighting[prop] = value end
            savedLighting = nil
        end
    end })

    PerfBox:AddToggle("FOV_Enabled", { Text = "Custom FOV", Default = false })
    PerfBox:AddSlider("FOV_Value",   { Text = "FOV", Min = 70, Max = 120, Default = 80, Rounding = 0 })
    connect(RunService.RenderStepped, function()
        if not Toggles.FOV_Enabled.Value then return end
        local camera = workspace.CurrentCamera
        local fov = Options.FOV_Value.Value
        if camera and camera.FieldOfView ~= fov then camera.FieldOfView = fov end
    end)

    local ExtremeBox = addGroup(VisualsTab, "Left", "Extreme Low Quality", "zap")
    local GREY_MATERIAL_COLOR = Color3.fromRGB(140,140,140)
    local extremeApplied = false
    local function applyExtremeLowQuality()
        if extremeApplied then return end
        extremeApplied = true
        applyGreySky()
        -- Lighting.Technology is read-only at runtime; skip the assignment attempt
        Lighting.GlobalShadows = false
        for _, obj in workspace:GetDescendants() do
            pcall(function()
                if obj:IsA("BasePart") then
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Color = GREY_MATERIAL_COLOR
                    obj.Reflectance = 0
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = 1
                elseif obj:IsA("SpecialMesh") then
                    obj.TextureId = ""
                elseif obj:IsA("SurfaceAppearance") then
                    obj.Parent = nil
                elseif isFx(obj) then
                    obj.Enabled = false
                end
            end)
        end
        if type(setfflag) == "function" then pcall(function() setfflag("FIntDebugTextureManagerSkipMips","8") end) end
    end

    local BOOST_GREY = Color3.fromRGB(85,85,85)
    local boostApplied = false
    local function inCharacter(obj)
        local model = obj:FindFirstAncestorWhichIsA("Model")
        while model do
            if model:FindFirstChildOfClass("Humanoid") then return true end
            model = model:FindFirstAncestorWhichIsA("Model")
        end
        return false
    end
    local function stripEffect(obj)
        if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then obj:Destroy(); return true
        elseif (obj:IsA("Trail") or obj:IsA("Beam")) and obj.Name ~= "ChillTrail" then obj.Enabled = false; return true
        elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then obj.Enabled = false; return true end
        return false
    end
    local function boostMapObject(obj)
        if obj:IsA("Terrain") then return end
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
            obj.Color = BOOST_GREY
            if obj:IsA("MeshPart") then
                obj.TextureID = ""
                obj.RenderFidelity = Enum.RenderFidelity.Performance
            end
            if (obj:IsA("MeshPart") or obj:IsA("UnionOperation")) and obj.Anchored and obj.Size.Magnitude < 60 then
                obj.LocalTransparencyModifier = 1
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance") then
            obj:Destroy()
        elseif obj:IsA("SpecialMesh") then
            obj.TextureId = ""
        end
    end
    local function applyMassiveBoost()
        if boostApplied then Library:Notify("Massive FPS Boost is already applied", 4); return end
        boostApplied = true
        pcall(function() Lighting.GlobalShadows = false end)
        for _, child in Lighting:GetChildren() do
            if child:IsA("PostEffect") or child:IsA("Atmosphere") then pcall(function() child:Destroy() end) end
        end
        pcall(function()
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            if terrain then
                terrain.Decoration = false
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 0
                local clouds = terrain:FindFirstChildOfClass("Clouds")
                if clouds then clouds:Destroy() end
            end
        end)
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        if type(setfflag) == "function" then pcall(function() setfflag("FIntDebugTextureManagerSkipMips","8") end) end
        local count = 0
        for _, obj in workspace:GetDescendants() do
            pcall(function()
                if not stripEffect(obj) and not inCharacter(obj) then boostMapObject(obj) end
            end)
            count += 1
            if count % 1500 == 0 then task.wait() end
        end
        Library:Notify("Massive FPS Boost applied, rejoin to undo.", 6)
    end
    connect(workspace.DescendantAdded, function(obj)
        if not boostApplied then return end
        task.defer(function()
            pcall(function()
                if not stripEffect(obj) then
                    if (obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance")) and not inCharacter(obj) then
                        obj:Destroy()
                    end
                end
            end)
        end)
    end)

    local extremeButton = ExtremeBox:AddButton({ Text = "Extreme Low Quality", Func = function()
        Library:Notify("Drastic visual change incoming, rejoin to undo. Applying in 4s...", 5)
        task.delay(4, function()
            if unloaded then return end
            applyExtremeLowQuality()
            Library:Notify("Extreme Low Quality applied. Rejoin to undo.", 5)
        end)
    end })
    extremeButton:AddButton({ Text = "Massive FPS Boost", Func = function()
        Library:Notify("Applying Massive FPS Boost, this may freeze for a second...", 4)
        task.spawn(applyMassiveBoost)
    end })
end

