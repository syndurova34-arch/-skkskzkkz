                wing.Size=UDim2.fromOffset(14,6)
                wing.Position=UDim2.fromOffset(8,-6)
                wing.Parent=frame
                o={frame=frame,x=PLAY_W+10,y=y,w=34,h=18,bird=true,wing=wing,flap=0}
            else
                local w=math.random(14,30)
                local h=math.random(30,52)
                local y=GROUND_Y-h
                frame.Size=UDim2.fromOffset(w,h)
                frame.BackgroundColor3=Color3.fromRGB(80,190,110)
                frame.Position=UDim2.fromOffset(PLAY_W+10,y)
                local armLeft=Instance.new("Frame")
                armLeft.BorderSizePixel=0
                armLeft.BackgroundColor3=frame.BackgroundColor3
                armLeft.Size=UDim2.fromOffset(6,5)
                armLeft.Position=UDim2.fromOffset(-6,math.floor(h*0.35))
                armLeft.Parent=frame
