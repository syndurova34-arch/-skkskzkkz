    local randomTimer=0
    AttachBox:AddDropdown("Attach_Target",   { SpecialType="Player", ExcludeLocalPlayer=true, Text="Attach Target" })
    AttachBox:AddDropdown("Attach_Position", { Values={"Front","Back","Left","Right","Front Left","Front Right","Back Left","Back Right","Top","Bottom","Piggyback","Orbit","Vertical Orbit","Helix","Random"}, Default=2, Text="Attach Position" })
    AttachBox:AddSlider("Attach_Distance",   { Text="Distance",    Min=1,  Max=25,  Default=3,  Rounding=1, Suffix=" studs" })
    AttachBox:AddSlider("Attach_SpinSpeed",  { Text="Orbit Speed", Min=10, Max=720, Default=90, Rounding=0, Suffix=" deg/s" })
    AttachBox:AddToggle("Attach_FaceTarget", { Text="Face Target", Default=false })
    AttachBox:AddToggle("Attach_Enabled",    { Text="Attach To Player", Default=false })

    local function getAttachCFrame(targetRoot,dt)
        local position=Options.Attach_Position.Value
        local distance=Options.Attach_Distance.Value
        local base=targetRoot.CFrame
        local center=targetRoot.Position
        local diagonal=distance*0.7071
        local result=nil
        local alwaysFace=false
        local faceAllowed=true
        spinAngle+=Options.Attach_SpinSpeed.Value*dt
        local radians=math.rad(spinAngle)
        if position=="Front" then result=base*CFrame.new(0,0,-distance)
        elseif position=="Back" then result=base*CFrame.new(0,0,distance)
        elseif position=="Left" then result=base*CFrame.new(-distance,0,0)
        elseif position=="Right" then result=base*CFrame.new(distance,0,0)
        elseif position=="Front Left"  then result=base*CFrame.new(-diagonal,0,-diagonal)
        elseif position=="Front Right" then result=base*CFrame.new(diagonal,0,-diagonal)
        elseif position=="Back Left"   then result=base*CFrame.new(-diagonal,0,diagonal)
        elseif position=="Back Right"  then result=base*CFrame.new(diagonal,0,diagonal)
        elseif position=="Top"         then result=base*CFrame.new(0,distance,0); faceAllowed=false
        elseif position=="Bottom"      then result=base*CFrame.new(0,-distance,0); faceAllowed=false
        elseif position=="Piggyback"   then result=base*CFrame.new(0,distance*0.6,distance*0.35)
        elseif position=="Orbit"       then result=CFrame.new(center+Vector3.new(math.sin(radians)*distance,0,math.cos(radians)*distance)); alwaysFace=true
        elseif position=="Vertical Orbit" then result=CFrame.new(center+base.RightVector*(math.sin(radians)*distance)+base.UpVector*(math.cos(radians)*distance)); alwaysFace=true
        elseif position=="Helix"       then result=CFrame.new(center+Vector3.new(math.sin(radians)*distance,math.sin(radians*2)*distance*0.5,math.cos(radians)*distance)); alwaysFace=true
        elseif position=="Random"      then
            randomTimer+=dt
            if randomTimer>=0.4 then
                randomTimer=0
                local direction=Vector3.new(math.random(-100,100),math.random(-30,100),math.random(-100,100))
                if direction.Magnitude<1 then direction=Vector3.new(0,0,1) end
                randomOffset=direction.Unit*distance
            end
            result=CFrame.new(center+randomOffset)
            alwaysFace=true
        else result=base*CFrame.new(0,0,distance) end
        if alwaysFace or (faceAllowed and Toggles.Attach_FaceTarget.Value) then
            result=CFrame.lookAt(result.Position,center)
        end
        return result
    end

    connect(RunService.Heartbeat,function(dt)
        if not Toggles.Attach_Enabled.Value or Shared.flinging then return end
        local target=resolvePlayer(Options.Attach_Target.Value)
        local myRoot=getRoot()
        local targetRoot=target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if myRoot and targetRoot then
            myRoot.CFrame=getAttachCFrame(targetRoot,dt)
        end
    end)
