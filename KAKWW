do
    local PosBox=addGroup(UniversalTab,"Right","Spectate & Positions","video")
    local spectating=false
    local spectateOverride=nil
    local spectateYaw=0
    local spectatePitch=math.rad(-12)
    local spectateDistance=12
    local savedCameraType=nil
    local lastFocus=nil

    local function currentSpectateTarget()
        if spectateOverride and spectateOverride.Parent==Players then return spectateOverride end
        return resolvePlayer(Options.Spectate_Target.Value)
    end
    local function stopSpectate()
        if not spectating then return end
        spectating=false
        pcall(function() RunService:UnbindFromRenderStep("ChillhubSpectate") end)
        local camera=workspace.CurrentCamera
        if camera then
            camera.CameraType=savedCameraType or Enum.CameraType.Custom
            local humanoid=getHumanoid()
            if humanoid then camera.CameraSubject=humanoid end
        end
        savedCameraType=nil
    end
    local function startSpectate()
        local camera=workspace.CurrentCamera
        if spectating or not camera then return end
        if not currentSpectateTarget() then
            Library:Notify("Pick a player to spectate first",3)
            local toggle=Toggles.Spectate_Enabled
            if toggle then toggle:SetValue(false) end
            return
        end
        spectating=true
        savedCameraType=camera.CameraType
        lastFocus=nil
        spectateDistance=12
        RunService:BindToRenderStep("ChillhubSpectate",Enum.RenderPriority.Camera.Value+2,function()
            local cam=workspace.CurrentCamera
            if not cam then return end
            local plr=currentSpectateTarget()
            local character=plr and plr.Character
            local root=character and character:FindFirstChild("HumanoidRootPart")
            local humanoid=character and character:FindFirstChildOfClass("Humanoid")
            if Options.Spectate_Mode.Value=="Camera Subject" then
                if humanoid then
                    if cam.CameraType~=Enum.CameraType.Custom then cam.CameraType=Enum.CameraType.Custom end
                    if cam.CameraSubject~=humanoid then cam.CameraSubject=humanoid end
                end
                return
            end
            if root then lastFocus=root.Position+Vector3.new(0,2,0) end
            if not lastFocus then return end
            cam.CameraType=Enum.CameraType.Scriptable
            local rotation=CFrame.Angles(0,spectateYaw,0)*CFrame.Angles(spectatePitch,0,0)
            cam.CFrame=CFrame.new(lastFocus)*rotation*CFrame.new(0,0,spectateDistance)
        end)
    end

    PosBox:AddDropdown("Spectate_Target",{ SpecialType="Player", ExcludeLocalPlayer=true, Text="Spectate Target", Callback=function() spectateOverride=nil end })
    PosBox:AddDropdown("Spectate_Mode",  { Values={"Orbit Camera","Camera Subject"}, Default=1, Text="Spectate Mode", Tooltip="Orbit Camera works in every game. Camera Subject uses the game's own camera." })
    PosBox:AddToggle("Spectate_Enabled", { Text="Spectate Player", Default=false, Callback=function(value)
        if value then startSpectate() else stopSpectate() end
    end })

    local function cycleSpectate(step)
        local list={}
        for _,plr in Players:GetPlayers() do
            if plr~=LocalPlayer then table.insert(list,plr) end
        end
        if #list==0 then Library:Notify("No other players to spectate",3); return end
        table.sort(list,function(a,b) return a.Name<b.Name end)
        local current=currentSpectateTarget()
        local index=0
        for i,plr in list do if plr==current then index=i end end
        spectateOverride=list[((index-1+step)%#list)+1]
        Library:Notify("Spectating "..spectateOverride.DisplayName,2)
    end

    local previousButton=PosBox:AddButton({ Text="Previous Player", Func=function() cycleSpectate(-1) end })
    previousButton:AddButton({ Text="Next Player", Func=function() cycleSpectate(1) end })

    connect(UserInputService.InputChanged,function(input)
        if not spectating then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                spectateYaw=spectateYaw-input.Delta.X*0.005
                spectatePitch=math.clamp(spectatePitch-input.Delta.Y*0.005,-1.4,1.4)
            end
        elseif input.UserInputType==Enum.UserInputType.MouseWheel then
            spectateDistance=math.clamp(spectateDistance-input.Position.Z*2,3,100)
        end
    end)
    onCleanup(stopSpectate)

    local savedCFrame=nil
    PosBox:AddButton({ Text="Save Position", Func=function()
        local root=getRoot()
        if root then savedCFrame=root.CFrame; Library:Notify("Position saved",3) end
    end })
    PosBox:AddButton({ Text="Teleport To Saved Position", Func=function()
        local root=getRoot()
        if not savedCFrame then Library:Notify("Save a position first",3)
        elseif root then root.AssemblyLinearVelocity=Vector3.zero; root.CFrame=savedCFrame end
    end })
    PosBox:AddToggle("AntiVoid_Enabled",{ Text="Anti Void", Default=false })
    local lastSafe=nil
    task.spawn(function()
        while not unloaded do
            local humanoid=getHumanoid()
            local root=getRoot()
            if Toggles.AntiVoid_Enabled.Value and humanoid and root then
                if humanoid.FloorMaterial~=Enum.Material.Air then
                    lastSafe=root.CFrame
                elseif lastSafe and root.Position.Y<workspace.FallenPartsDestroyHeight+150 then
                    root.AssemblyLinearVelocity=Vector3.zero
                    root.CFrame=lastSafe+Vector3.new(0,5,0)
                end
            end
            task.wait(0.1)
        end
    end)
end

