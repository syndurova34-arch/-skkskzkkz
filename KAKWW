end

do
    local WorldBox = addGroup(VisualsTab, "Left", "World & Camera", "globe")
    local xrayOn=false
    local xrayGen=0
    local xrayParts={}
    local function belongsToCharacter(obj)
        local model=obj:FindFirstAncestorWhichIsA("Model")
        while model do
            if model:FindFirstChildOfClass("Humanoid") then return true end
            model=model:FindFirstAncestorWhichIsA("Model")
        end
        return false
    end
    local function xrayValue()
        local opt=Options.XRay_Transparency
        return ((opt and opt.Value) or 60)/100
    end
    local function applyXray(obj,value)
        if obj:IsA("BasePart") and not obj:IsA("Terrain") and not belongsToCharacter(obj) then
            if xrayParts[obj]==nil then xrayParts[obj]=obj.LocalTransparencyModifier end
            obj.LocalTransparencyModifier=value
        end
    end
    local function restoreXray()
        for part,original in xrayParts do
            if part.Parent then part.LocalTransparencyModifier=original end
            xrayParts[part]=nil
        end
    end
    local function refreshXray()
        xrayGen+=1
        local gen=xrayGen
        if not xrayOn then restoreXray(); return end
        local value=xrayValue()
        for part in xrayParts do
            if part.Parent then part.LocalTransparencyModifier=value else xrayParts[part]=nil end
        end
        local count=0
        for _,obj in workspace:GetDescendants() do
            if gen~=xrayGen then return end
            applyXray(obj,value)
            count+=1
            if count%1500==0 then task.wait() end
        end
    end
    connect(workspace.DescendantAdded,function(obj)
        if not xrayOn then return end
        task.defer(function() if xrayOn then applyXray(obj,xrayValue()) end end)
    end)
    WorldBox:AddToggle("XRay_Enabled",      { Text="X-Ray", Default=false, Callback=function(value) xrayOn=value; task.spawn(refreshXray) end })
    WorldBox:AddSlider("XRay_Transparency", { Text="X-Ray Transparency", Min=10, Max=95, Default=60, Rounding=0, Suffix="%", Callback=function() if xrayOn then task.spawn(refreshXray) end end })
    onCleanup(function() xrayOn=false; refreshXray() end)

    local defaultMaxZoom=LocalPlayer.CameraMaxZoomDistance
    local defaultMinZoom=LocalPlayer.CameraMinZoomDistance
    WorldBox:AddToggle("Camera_UnlockZoom", { Text="Unlock Camera Zoom", Default=false, Callback=function(value)
        if value then
            LocalPlayer.CameraMaxZoomDistance=10000
            LocalPlayer.CameraMinZoomDistance=0.5
        else
            LocalPlayer.CameraMaxZoomDistance=defaultMaxZoom
            LocalPlayer.CameraMinZoomDistance=defaultMinZoom
        end
    end })

    local CrosshairBox = addGroup(VisualsTab, "Right", "Crosshair", "crosshair")
    local crosshairToggle=CrosshairBox:AddToggle("Crosshair_Enabled",{ Text="Custom Crosshair", Default=false })
    crosshairToggle:AddColorPicker("Crosshair_Color",{ Default=Color3.fromRGB(0,255,120), Title="Crosshair Color" })
    CrosshairBox:AddSlider("Crosshair_Size",      { Text="Size",      Min=2,  Max=30, Default=8,  Rounding=0 })
    CrosshairBox:AddSlider("Crosshair_Gap",       { Text="Gap",       Min=0,  Max=20, Default=3,  Rounding=0 })
    CrosshairBox:AddSlider("Crosshair_Thickness", { Text="Thickness", Min=1,  Max=5,  Default=1,  Rounding=0 })
    local crosshairLines={}
    if type(Drawing)=="table" then
        for i=1,4 do
            local ok,line=pcall(function()
                local l=Drawing.new("Line")
                l.Transparency=1
                l.Visible=false
                return l
            end)
            if ok then crosshairLines[i]=line end
        end
    end
    connect(RunService.RenderStepped,function()
        local camera=workspace.CurrentCamera
        local show=Toggles.Crosshair_Enabled.Value and camera~=nil
        for _,line in pairs(crosshairLines) do line.Visible=show end
        if not show then return end
        local size=Options.Crosshair_Size.Value
        local gap=Options.Crosshair_Gap.Value
        local thickness=Options.Crosshair_Thickness.Value
        local color=Options.Crosshair_Color.Value
        local center=camera.ViewportSize/2
        local cx=center.X; local cy=center.Y
        local segments={
            {Vector2.new(cx-gap-size,cy),Vector2.new(cx-gap,cy)},
            {Vector2.new(cx+gap,cy),Vector2.new(cx+gap+size,cy)},
            {Vector2.new(cx,cy-gap-size),Vector2.new(cx,cy-gap)},
            {Vector2.new(cx,cy+gap),Vector2.new(cx,cy+gap+size)},
        }
        for i,segment in segments do
            local line=crosshairLines[i]
            if line then
                line.From=segment[1]
                line.To=segment[2]
                line.Color=color
                line.Thickness=thickness
            end
        end
    end)
    onCleanup(function()
        for i,line in pairs(crosshairLines) do pcall(function() line:Remove() end); crosshairLines[i]=nil end
    end)
end

