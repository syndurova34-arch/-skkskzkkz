-- ---------------------------------------------------------------------------
do
    local SafeBox=addGroup(CombatTab,"Left","Auto Safezone","shield")
    local SafeControls=addGroup(CombatTab,"Right","Safezone Controls","navigation")
    SafeBox:AddToggle("Combat_Safezone_Enabled",{ Text="Auto Safezone", Default=false, Tooltip="When your health drops to the trigger level you get teleported up to a sky platform." })
    SafeBox:AddSlider("Combat_Safezone_Health", { Text="Trigger At Health",  Min=5,   Max=95,   Default=50,  Rounding=0, Suffix="%" })
    SafeBox:AddSlider("Combat_Safezone_Height", { Text="Safezone Height",    Min=100, Max=3000, Default=500, Rounding=0, Suffix=" studs" })
    SafeBox:AddSlider("Combat_Safezone_Size",   { Text="Platform Size",      Min=60,  Max=800,  Default=400, Rounding=0, Suffix=" studs" })
    SafeBox:AddToggle("Combat_Safezone_Walls",  { Text="Edge Walls", Default=true, Tooltip="Faint walls so you can't fall off." })
    SafeBox:AddSlider("Combat_Safezone_ReturnTime",{ Text="Auto Return After (0 = stay)", Min=0, Max=120, Default=0, Rounding=0, Suffix="s" })

    local PLATFORM_THICKNESS=4
    local WALL_HEIGHT=60
    local safezone=nil
    local lastHealth=nil
    local healthConn=nil

    local function makePart(container,name,size,cframe,transparency)
        local part=Instance.new("Part")
        part.Name=name
        part.Anchored=true
        part.CanCollide=true
        part.CastShadow=false
        part.Material=Enum.Material.ForceField
        part.Color=ACCENT
        part.Transparency=transparency
        part.Size=size
        part.CFrame=cframe
        part.Parent=container
        return part
    end
    local function destroySafezone()
        if safezone then
            local data=safezone
            safezone=nil
            if data.container then data.container:Destroy() end
        end
    end
    local function leaveSafezone()
        if not safezone then return end
        local data=safezone
        destroySafezone()
        local root=getRoot()
        if root and data.returnCFrame then
            root.AssemblyLinearVelocity=Vector3.zero
            root.CFrame=data.returnCFrame
        end
    end
    local function enterSafezone()
        if safezone then return end
        local root=getRoot()
        if not root then return end
        local returnCFrame=root.CFrame
        local size=Options.Combat_Safezone_Size.Value
        local center=returnCFrame.Position+Vector3.new(0,Options.Combat_Safezone_Height.Value,0)
        local container=Instance.new("Folder")
        container.Name="ChillSafezone"
        makePart(container,"Platform",Vector3.new(size,PLATFORM_THICKNESS,size),CFrame.new(center),0.5)
        if Toggles.Combat_Safezone_Walls.Value then
            local half=size/2
            local wallCenter=center+Vector3.new(0,PLATFORM_THICKNESS/2+WALL_HEIGHT/2,0)
            makePart(container,"WallN",Vector3.new(size,WALL_HEIGHT,2),CFrame.new(wallCenter+Vector3.new(0,0,half)),0.9)
            makePart(container,"WallS",Vector3.new(size,WALL_HEIGHT,2),CFrame.new(wallCenter-Vector3.new(0,0,half)),0.9)
            makePart(container,"WallE",Vector3.new(2,WALL_HEIGHT,size),CFrame.new(wallCenter+Vector3.new(half,0,0)),0.9)
            makePart(container,"WallW",Vector3.new(2,WALL_HEIGHT,size),CFrame.new(wallCenter-Vector3.new(half,0,0)),0.9)
        end
        container.Parent=workspace
        local data={container=container,center=center,size=size,returnCFrame=returnCFrame}
        safezone=data
        root.AssemblyLinearVelocity=Vector3.zero
        root.CFrame=CFrame.new(center+Vector3.new(0,PLATFORM_THICKNESS/2+4,0))
        Library:Notify("Safezone activated",3)
        local delaySeconds=Options.Combat_Safezone_ReturnTime.Value
        if delaySeconds>0 then
            task.delay(delaySeconds,function() if safezone==data then leaveSafezone() end end)
        end
    end

    connect(RunService.Heartbeat,function()
        local data=safezone
        if not data then return end
        local root=getRoot()
        if not root then return end
        local rel=root.Position-data.center
        local limit=data.size/2+4
        if rel.Y<-8 or math.abs(rel.X)>limit or math.abs(rel.Z)>limit then
            root.AssemblyLinearVelocity=Vector3.zero
            root.CFrame=CFrame.new(data.center+Vector3.new(0,PLATFORM_THICKNESS/2+4,0))
        end
    end)

    local function watchCharacter(character)
        local humanoid=character:WaitForChild("Humanoid",10)
        if not humanoid then return end
        if healthConn then healthConn:Disconnect() end
        lastHealth=humanoid.Health
        healthConn=humanoid.HealthChanged:Connect(function(health)
            local tookDamage=lastHealth~=nil and health<lastHealth
            lastHealth=health
            if not tookDamage or health<=0 then return end
            if not Toggles.Combat_Safezone_Enabled.Value or safezone then return end
            local triggerAt=humanoid.MaxHealth*(Options.Combat_Safezone_Health.Value/100)
            if health<=triggerAt then enterSafezone() end
        end)
    end

    SafeControls:AddButton({ Text="Go To Safezone Now", Func=enterSafezone })
    SafeControls:AddButton({ Text="Return To Ground",    Func=leaveSafezone })
    SafeControls:AddLabel({ Text="Safezone key is set in the Home tab (default N).", DoesWrap=true })

    connect(UserInputService.InputBegan,function(input,processed)
        if processed then return end
        local key=keyFromOption("Combat_Safezone_Key")
        if key and input.KeyCode==key then
            if safezone then leaveSafezone() else enterSafezone() end
        end
    end)
    connect(LocalPlayer.CharacterAdded,function(character) destroySafezone(); watchCharacter(character) end)
    if LocalPlayer.Character then task.spawn(watchCharacter,LocalPlayer.Character) end
    onCleanup(function()
        if healthConn then healthConn:Disconnect(); healthConn=nil end
        destroySafezone()
    end)
end

