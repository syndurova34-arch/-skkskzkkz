        end
    end
    local function applyHeadless()
        local humanoid=getHumanoidOrWarn()
        if not humanoid then return end
        if humanoid.RigType==Enum.HumanoidRigType.R15 then
            applyDescriptionAsset(humanoid,"Head",HEADLESS_ASSET_ID,"Headless"); return
        end
        local head=humanoid.Parent and humanoid.Parent:FindFirstChild("Head")
        if not head then return end
        local specialMesh=head:FindFirstChildOfClass("SpecialMesh")
        if specialMesh then specialMesh.MeshId=""; specialMesh.TextureId="" end
        for _,child in head:GetChildren() do
            if child:IsA("Decal") then child:Destroy() end
        end
