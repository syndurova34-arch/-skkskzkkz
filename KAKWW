                armRight.Size=UDim2.fromOffset(6,5)
                armRight.Position=UDim2.fromOffset(w,math.floor(h*0.2))
                armRight.Parent=frame
                o={frame=frame,x=PLAY_W+10,y=y,w=w,h=h,bird=false}
            end
            table.insert(obstacles,o)
        end
        local function isCrouching() return ducking and dinoH<=0 end
        local function dinoRect()
            local w=STAND_W
            local h=STAND_H
            if isCrouching() then w=DUCK_W; h=DUCK_H end
            return DINO_X+5,GROUND_Y-dinoH-h+3,DINO_X+w-5,GROUND_Y-dinoH-3
        end
        local function refreshDino()
            local crouch=isCrouching()
            local legStep=state=="running" and dinoH<=0 and stepFlag
            local key=(crouch and "d" or "s")..(legStep and "1" or "0")
            if key~=lastLayout then lastLayout=key; layoutDino(crouch,legStep) end
            dinoFrame.Position=UDim2.fromOffset(DINO_X,GROUND_Y-dinoH)
        end
        local function die()
            state="dead"
            deadAt=os.clock()
            local final=math.floor(score)
            if final>highScore then
                highScore=final
                saveHighScore()
                highLabel:SetText("Best: "..tostring(highScore))
            end
            updateScoreText()
            messageLabel.Text="G A M E   O V E R\npress Space / click to restart"
        end
        local function jump()
            if state=="ready" then
                state="running"
                messageLabel.Text=""
            elseif state=="dead" then
                if os.clock()-deadAt>0.4 then
                    resetGame()
                    state="running"
                    messageLabel.Text=""
                end
                return
            end
            if dinoH<=0 then vy=JUMP_VELOCITY end
        end
        local function step(dt)
            dt=math.min(dt,0.05)
            for _,cloud in clouds do
                cloud.x=cloud.x-40*dt
                if cloud.x<-60 then cloud.x=PLAY_W+math.random(20,120) end
                cloud.frame.Position=UDim2.fromOffset(cloud.x,cloud.y)
            end
            if state~="running" then refreshDino(); return end
            if dinoH>0 or vy>0 then
                local g=GRAVITY
                if ducking then g=g*FAST_FALL end
                vy=vy-g*dt
                dinoH=dinoH+vy*dt
                if dinoH<=0 then dinoH=0; vy=0 end
            end
            runTimer=runTimer+dt
            if runTimer>=0.1 then runTimer=0; stepFlag=not stepFlag end
            score=score+speed*dt/40
            speed=math.min(300+score*0.9,760)
            local scoreInt=math.floor(score)
            if scoreInt~=lastScoreInt then lastScoreInt=scoreInt; updateScoreText() end
            nextSpawn=nextSpawn-speed*dt
            if nextSpawn<=0 then spawnObstacle(); nextSpawn=speed*(0.85+math.random()*0.75) end
            refreshDino()
            local dinoLeft,dinoTop,dinoRight,dinoBottom=dinoRect()
            for i=#obstacles,1,-1 do
                local o=obstacles[i]
                o.x=o.x-speed*dt
                o.frame.Position=UDim2.fromOffset(o.x,o.y)
                if o.bird then
                    o.flap=o.flap+dt
                    o.wing.Position=UDim2.fromOffset(8,(o.flap%0.3<0.15) and -6 or 16)
                end
                if o.x+o.w<-20 then
                    o.frame:Destroy()
                    table.remove(obstacles,i)
                else
                    local oLeft=o.x+3
                    local oRight=o.x+o.w-3
                    local oTop=o.y+3
                    local oBottom=o.y+o.h-3
                    if dinoLeft<oRight and dinoRight>oLeft and dinoTop<oBottom and dinoBottom>oTop then
                        die()
                        return
                    end
                end
            end
        end
        local actionName="ChillhubDinoInput"
        local function handleAction(_,inputState,inputObject)
            local code=inputObject.KeyCode
            if inputState==Enum.UserInputState.Begin then
                if code==Enum.KeyCode.Space or code==Enum.KeyCode.Up or code==Enum.KeyCode.W then
                    jump()
                elseif code==Enum.KeyCode.Down or code==Enum.KeyCode.S then
                    ducking=true
                end
            elseif inputState==Enum.UserInputState.End then
                if code==Enum.KeyCode.Down or code==Enum.KeyCode.S then
                    ducking=false
                end
            end
            return Enum.ContextActionResult.Sink
        end
        ContextActionService:BindActionAtPriority(actionName,handleAction,false,Enum.ContextActionPriority.High.Value,Enum.KeyCode.Space,Enum.KeyCode.Up,Enum.KeyCode.W,Enum.KeyCode.Down,Enum.KeyCode.S)
        play.InputBegan:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
                jump()
            end
        end)
        local connection=RunService.Heartbeat:Connect(step)
        resetGame()
        messageLabel.Text="Press Space / click to start"
        refreshDino()
        activeGame={destroy=function()
            connection:Disconnect()
            stopDrag()
            ContextActionService:UnbindAction(actionName)
            gui:Destroy()
        end}
    end

    GameBox:AddButton({ Text="Play Dino Run",   Func=openDino })
    GameBox:AddButton({ Text="Close Game",       Func=closeDino })
    GameBox:AddButton({ Text="Reset Best Score", Func=function() highScore=0; saveHighScore(); highLabel:SetText("Best: 0") end })
    GameBox:AddLabel({ Text="Space / Up / W / click = jump. Down / S = duck. Character won't move while the game is open.", DoesWrap=true })
    onCleanup(closeDino)
end

