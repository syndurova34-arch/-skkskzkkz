    local function getHumanoidOrWarn()
        local humanoid=getHumanoid()
        if not humanoid then Library:Notify("No character found",4) end
        return humanoid
    end
    local function applyDescriptionAsset(humanoid,field,assetId,label)
        local ok=pcall(function()
            local description=humanoid:GetAppliedDescription()
            description[field]=assetId
            humanoid:ApplyDescription(description)
        end)
        if ok then
            Library:Notify(label.." applied",3)
