    FlingBox:AddToggle("Fling_ReturnBack", { Text="Return To My Spot After", Default=true })

    local function flingPlayer(target)
        if Shared.flinging then return end
        local root=getRoot()
        local humanoid=getHumanoid()
        local targetRoot=target and targetInfo(target)
        if not root or not humanoid or not targetRoot then
            Library:Notify("Can't fling: pick a target that is alive and in the game",3)
            return
        end
        Shared.flinging=true
        Shared.restoreNoclip()
        local origin=root.CFrame
        local power=Options.Fling_Power.Value
        local duration=Options.Fling_Duration.Value/1000
        local startedAt=os.clock()
        Library:Notify("Flinging "..target.DisplayName.."...",2)
        task.spawn(function()
            pcall(function()
                humanoid.PlatformStand=true
                while os.clock()-startedAt<duration do
                    local myRoot=getRoot()
                    local theirRoot=targetInfo(target)
                    if not myRoot or not theirRoot then break end
                    myRoot.CFrame=theirRoot.CFrame
                    myRoot.AssemblyAngularVelocity=Vector3.new(0,power,0)
                    myRoot.AssemblyLinearVelocity=Vector3.new(power,power,power)
                    RunService.Heartbeat:Wait()
                end
            end)
            local myRoot=getRoot()
            if myRoot then
                myRoot.AssemblyAngularVelocity=Vector3.zero
                myRoot.AssemblyLinearVelocity=Vector3.zero
                if Toggles.Fling_ReturnBack.Value then myRoot.CFrame=origin end
            end
            local h=getHumanoid()
            if h then
                h.PlatformStand=false
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            Shared.flinging=false
        end)
    end

    FlingBox:AddButton({ Text="Fling Target", Func=function() flingPlayer(resolvePlayer(Options.Fling_Target.Value)) end })
    FlingBox:AddToggle("FlingAura_Enabled", { Text="Fling Aura", Default=false, Tooltip="Automatically flings any player who comes within the radius." })
    FlingBox:AddSlider("FlingAura_Radius",  { Text="Fling Aura Radius", Min=5, Max=100, Default=15, Rounding=0, Suffix=" studs" })
    FlingBox:AddLabel({ Text="Fling uses physics, so TSB may block or reduce it.", DoesWrap=true })

    local flingAuraCooldowns={}
    connect(RunService.Heartbeat,function()
        if not Toggles.FlingAura_Enabled.Value or Shared.flinging then return end
        local myRoot=getRoot()
        if not myRoot then return end
        local radius=Options.FlingAura_Radius.Value
        local now=os.clock()
        for _,plr in Players:GetPlayers() do
            if plr~=LocalPlayer then
                local root=targetInfo(plr)
                if root and (root.Position-myRoot.Position).Magnitude<=radius then
                    if not flingAuraCooldowns[plr] or now-flingAuraCooldowns[plr]>2 then
                        flingAuraCooldowns[plr]=now
                        flingPlayer(plr)
                        break
                    end
                end
            end
        end
    end)
end

