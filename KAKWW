    local InfoBox = addGroup(VisualsTab, "Right", "Info ESP", "info")
    InfoBox:AddToggle("ESP_Names",    { Text = "Names",    Default = false })
    InfoBox:AddToggle("ESP_Health",   { Text = "Health",   Default = false })
    InfoBox:AddToggle("ESP_Distance", { Text = "Distance", Default = false })
    local skeletonToggle = InfoBox:AddToggle("ESP_Skeleton", { Text = "Skeleton (R6 + R15)", Default = false, Tooltip = "Draws a bone skeleton over each player. Works on both R6 and R15 rigs." })
    skeletonToggle:AddColorPicker("ESP_Skeleton_Color", { Default = Color3.fromRGB(230, 230, 210), Title = "Skeleton Color" })

    local espHighlights = {}; local infoBoards = {}; local skeletonLines = {}

    local SKELETON_JOINTS_R15 = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    }
    local SKELETON_JOINTS_R6 = {
        {"Head","Torso"},{"Torso","Left Arm"},{"Left Arm","Left Hand"},
        {"Torso","Right Arm"},{"Right Arm","Right Hand"},
        {"Torso","Left Leg"},{"Left Leg","Left Foot"},
        {"Torso","Right Leg"},{"Right Leg","Right Foot"},
        {"HumanoidRootPart","Torso"},
    }
    local BONE_THICKNESS = 2.5
    local function getBoneColor()
        return Options.ESP_Skeleton_Color and Options.ESP_Skeleton_Color.Value or Color3.fromRGB(230,230,210)
    end

    local function getSkeletonJoints(character)
        if character:FindFirstChild("UpperTorso") then return SKELETON_JOINTS_R15 end
        return SKELETON_JOINTS_R6
    end

    local function removeHighlight(plr) local h=espHighlights[plr]; if h then h:Destroy(); espHighlights[plr]=nil end end
    local function removeInfo(plr) local board=infoBoards[plr]; if board then board.gui:Destroy(); infoBoards[plr]=nil end end
    local function removeSkeleton(plr)
        local lines=skeletonLines[plr]
        if lines then
            for _,line in lines do pcall(function() line:Remove() end) end
            skeletonLines[plr]=nil
        end
    end

    local function updateHighlight(plr)
        local character=plr.Character
        if plr==LocalPlayer or not Toggles.ESP_Enabled.Value or not character then removeHighlight(plr); return end
        local humanoid=character:FindFirstChildOfClass("Humanoid")
        if not humanoid then removeHighlight(plr); return end
        local h=espHighlights[plr]
        if not h or not h.Parent or h.Adornee~=character then
            if h then h:Destroy() end
            h=Instance.new("Highlight")
            h.Name="ChillESPHighlight"
            h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee=character
            h.Parent=character
            espHighlights[plr]=h
        end
        local fillColor=Options.ESP_Fill_Color.Value
        local outlineColor=Options.ESP_Outline_Color.Value
        if Toggles.ESP_HealthColor.Value and humanoid.MaxHealth>0 then
            local healthRatio=math.clamp(humanoid.Health/humanoid.MaxHealth,0,1)
            fillColor=Color3.fromHSV(healthRatio*0.33,1,1)
            outlineColor=fillColor
        end
        h.FillColor=fillColor
        h.FillTransparency=Toggles.ESP_Fill_Enabled.Value and 0.75 or 1
        h.OutlineColor=outlineColor
        h.OutlineTransparency=Toggles.ESP_Outline_Enabled.Value and 0 or 1
    end

    local function updateInfo(plr)
        local character=plr.Character
        local head=character and character:FindFirstChild("Head")
        local humanoid=character and character:FindFirstChildOfClass("Humanoid")
        local wantName=Toggles.ESP_Names.Value
        local wantHealth=Toggles.ESP_Health.Value
        local wantDistance=Toggles.ESP_Distance.Value
        if plr==LocalPlayer or not head or not humanoid or not (wantName or wantHealth or wantDistance) then
            removeInfo(plr); return
        end
        local board=infoBoards[plr]
        if not board or not board.gui.Parent or board.gui.Adornee~=head then
            if board then board.gui:Destroy() end
            local gui=Instance.new("BillboardGui")
            gui.Name="ChillInfoESP"
            gui.Size=UDim2.fromOffset(180,60)
            gui.StudsOffset=Vector3.new(0,3,0)
            gui.AlwaysOnTop=true
            gui.Adornee=head
            gui.Parent=head
            local label=Instance.new("TextLabel")
            label.Size=UDim2.fromScale(1,1)
            label.BackgroundTransparency=1
            label.TextColor3=Color3.new(1,1,1)
            label.TextStrokeTransparency=0
            label.Font=Enum.Font.GothamBold
            label.TextSize=13
            label.Parent=gui
            board={gui=gui,label=label}
            infoBoards[plr]=board
        end
        local lines={}
        if wantName then table.insert(lines,plr.DisplayName) end
        if wantHealth then
            table.insert(lines,("HP: %d / %d"):format(math.floor(humanoid.Health),math.floor(humanoid.MaxHealth)))
        end
        if wantDistance then
            local myRoot=getRoot()
            if myRoot then
                table.insert(lines,("%d studs"):format(math.floor((myRoot.Position-head.Position).Magnitude)))
            end
        end
        board.label.Text=table.concat(lines,"\n")
    end

    local drawingSupported=type(Drawing)=="table"

    local function updateSkeleton(plr,camera)
        if not drawingSupported then return end
        local character=plr.Character
        if plr==LocalPlayer or not Toggles.ESP_Skeleton.Value or not character or not Toggles.ESP_Enabled.Value then
            removeSkeleton(plr); return
        end
        local joints=getSkeletonJoints(character)
        local lines=skeletonLines[plr]
        if not lines or #lines~=#joints then
            if lines then for _,l in lines do pcall(function() l:Remove() end) end end
            lines={}
            for i=1,#joints do
                local ok,line=pcall(function()
                    local l=Drawing.new("Line")
                    l.Thickness=BONE_THICKNESS
                    l.Transparency=1
                    l.Color=getBoneColor()
                    l.Visible=false
                    return l
                end)
                if ok then lines[i]=line end
            end
            skeletonLines[plr]=lines
        end
        for i,pair in joints do
            local line=lines[i]
            if line then
                local partA=character:FindFirstChild(pair[1])
                local partB=character:FindFirstChild(pair[2])
                if partA and partB then
                    local posA,onA=camera:WorldToViewportPoint(partA.Position)
                    local posB,onB=camera:WorldToViewportPoint(partB.Position)
                    if onA or onB then
                        line.From=Vector2.new(posA.X,posA.Y)
                        line.To=Vector2.new(posB.X,posB.Y)
                        line.Color=getBoneColor()
                        line.Visible=true
                    else
                        line.Visible=false
                    end
                else
                    line.Visible=false
                end
            end
        end
    end

    local function hookPlayer(plr)
        if plr==LocalPlayer then return end
        if plr.Character then
            task.spawn(function()
                task.wait(0.5)
                pcall(function() updateHighlight(plr) end)
            end)
        end
        connect(plr.CharacterAdded,function()
            task.wait(0.5)
            pcall(function() updateHighlight(plr) end)
        end)
    end

    for _,plr in Players:GetPlayers() do hookPlayer(plr) end
    connect(Players.PlayerAdded,hookPlayer)
    connect(Players.PlayerRemoving,function(plr)
        removeHighlight(plr); removeInfo(plr); removeSkeleton(plr)
    end)

    task.spawn(function()
        while not unloaded do
            for _,plr in Players:GetPlayers() do
                if plr~=LocalPlayer then
                    pcall(function() updateHighlight(plr); updateInfo(plr) end)
                end
            end
            task.wait(0.25)
        end
    end)

    onCleanup(function()
        for plr in espHighlights do removeHighlight(plr) end
        for plr in infoBoards do removeInfo(plr) end
        for plr in skeletonLines do removeSkeleton(plr) end
    end)

    local tracerLines={}
    local function hideTracers() for _,line in tracerLines do line.Visible=false end end
    connect(RunService.RenderStepped,function()
        if not drawingSupported then return end
        local camera=workspace.CurrentCamera
        if not camera then return end
        if Toggles.ESP_Skeleton.Value then
            for _,plr in Players:GetPlayers() do
                if plr~=LocalPlayer then pcall(function() updateSkeleton(plr,camera) end) end
            end
        else
            for plr in skeletonLines do removeSkeleton(plr) end
        end
        if not Toggles.ESP_Tracers_Enabled.Value then hideTracers(); return end
        local origin=nil
        local myRoot=getRoot()
        if myRoot then
            local p,onScreen=camera:WorldToViewportPoint(myRoot.Position)
            if onScreen then origin=Vector2.new(p.X,p.Y) end
        end
        if not origin then
            local viewport=camera.ViewportSize
            origin=Vector2.new(viewport.X/2,viewport.Y/2)
        end
        local color=Options.ESP_Tracers_Color.Value
        for _,plr in Players:GetPlayers() do
            if plr~=LocalPlayer then
                local character=plr.Character
                local targetPart=character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
                local line=tracerLines[plr]
                local visible=false
                if targetPart then
                    local pos,onScreen=camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        if not line then
                            local ok,newLine=pcall(function()
                                local l=Drawing.new("Line")
                                l.Thickness=1
                                l.Transparency=1
                                return l
                            end)
                            if ok then line=newLine; tracerLines[plr]=line end
                        end
                        if line then
                            line.From=origin
                            line.To=Vector2.new(pos.X,pos.Y)
                            line.Color=color
                            line.Visible=true
                            visible=true
                        end
                    end
                end
                if line and not visible then line.Visible=false end
            end
        end
    end)
    connect(Players.PlayerRemoving,function(plr)
        local line=tracerLines[plr]
        if line then pcall(function() line:Remove() end); tracerLines[plr]=nil end
    end)
    onCleanup(function()
        for plr,line in tracerLines do pcall(function() line:Remove() end); tracerLines[plr]=nil end
    end)
end

