    LockBox:AddToggle("LockOn_AutoRelock", { Text="Auto Re-Lock When Target Is Lost", Default=true })

    local function targetInfo(plr)
        local character=plr.Character
        local root=character and character:FindFirstChild("HumanoidRootPart")
        local humanoid=character and character:FindFirstChildOfClass("Humanoid")
        if root and humanoid and humanoid.Health>0 then return root,humanoid end
        return nil
    end
    local function removeMarker()
        if marker then marker.gui:Destroy(); marker=nil end
    end
    local function sortedCandidates(mode)
        local myRoot=getRoot()
        local camera=workspace.CurrentCamera
        local list={}
        if not myRoot or not camera then return list end
        local range=Options.LockOn_Range.Value
        local priority=mode or Options.LockOn_Priority.Value
        local mousePos=UserInputService:GetMouseLocation()
        for _,plr in Players:GetPlayers() do
            if plr~=LocalPlayer then
                local root,humanoid=targetInfo(plr)
                if root then
                    local dist=(root.Position-myRoot.Position).Magnitude
                    if dist<=range then
                        local score=dist
                        if priority=="Lowest Health" then
                            score=humanoid.Health
                        elseif priority=="Closest To Crosshair" then
                            local pos,onScreen=camera:WorldToViewportPoint(root.Position)
                            score=onScreen and (Vector2.new(pos.X,pos.Y)-mousePos).Magnitude or math.huge
                        end
                        table.insert(list,{player=plr,score=score})
                    end
                end
            end
        end
        table.sort(list,function(a,b) return a.score<b.score end)
        return list
    end
    local function setLock(plr,silent)
        lockTarget=plr
        removeMarker()
        setAutoRotateLock("lockon",plr~=nil and Toggles.LockOn_FaceTarget.Value)
        if not silent then
            if plr then Library:Notify("Locked on: "..plr.DisplayName,2)
            else Library:Notify("Lock-on released",2) end
        end
    end
    local function toggleLock()
        if lockTarget then setLock(nil); return end
        local list=sortedCandidates()
        if list[1] then setLock(list[1].player)
        else Library:Notify("No players in range",2) end
    end
    local function switchTarget()
        local list=sortedCandidates("Closest")
        if #list==0 then Library:Notify("No players in range",2); return end
        local nextPlayer=list[1].player
        if lockTarget then
            for i,entry in list do
                if entry.player==lockTarget then
                    nextPlayer=list[(i%#list)+1].player
                    break
                end
            end
        end
        if nextPlayer~=lockTarget then setLock(nextPlayer) end
    end
    connect(UserInputService.InputBegan,function(input)
        if UserInputService:GetFocusedTextBox() then return end
        if inputMatchesBind(input,"LockOn_Key") then toggleLock()
        elseif inputMatchesBind(input,"LockOn_Switch") then switchTarget() end
    end)
    pcall(function() RunService:UnbindFromRenderStep("ChillhubLockOn") end)
    RunService:BindToRenderStep("ChillhubLockOn",Enum.RenderPriority.Camera.Value+1,function(dt)
        if not lockTarget then return end
        local camera=workspace.CurrentCamera
        local myRoot=getRoot()
        if not camera or not myRoot then return end
        local root,humanoid=targetInfo(lockTarget)
        local dist=math.huge
        if root and lockTarget.Parent==Players then dist=(root.Position-myRoot.Position).Magnitude end
        if not root or dist>Options.LockOn_Range.Value*1.5 then
            local old=lockTarget
            setLock(nil,true)
            if Toggles.LockOn_AutoRelock.Value then
                local list=sortedCandidates()
                if list[1] and list[1].player~=old then setLock(list[1].player); return end
            end
            Library:Notify("Lock-on lost its target",2)
            return
        end
        if Toggles.LockOn_CameraLock.Value then
            local alpha=1-(Options.LockOn_Smoothing.Value/100)
            alpha=math.clamp(1-(1-alpha)^(dt*60),0.02,1)
            camera.CFrame=camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position,root.Position),alpha)
        end
        if Toggles.LockOn_Marker.Value then
            if not marker or marker.gui.Parent~=root then
                removeMarker()
                local gui=Instance.new("BillboardGui")
                gui.Name="ChillLockOnMarker"
                gui.Size=UDim2.fromOffset(190,46)
                gui.StudsOffset=Vector3.new(0,4.5,0)
                gui.AlwaysOnTop=true
                gui.Adornee=root
                gui.Parent=root
                local label=Instance.new("TextLabel")
                label.Size=UDim2.fromScale(1,1)
                label.BackgroundTransparency=1
                label.TextColor3=Color3.fromRGB(255,90,90)
                label.TextStrokeTransparency=0
                label.Font=Enum.Font.GothamBold
                label.TextSize=14
                label.Parent=gui
                marker={gui=gui,label=label}
            end
            local healthPercent=math.floor(humanoid.Health/math.max(humanoid.MaxHealth,1)*100)
            marker.label.Text=("LOCKED: %s\nHP %d%%  |  %d studs"):format(lockTarget.DisplayName,healthPercent,math.floor(dist))
        else
            removeMarker()
        end
    end)
    connect(RunService.Heartbeat,function()
        if not lockTarget or not Toggles.LockOn_FaceTarget.Value or dashing or Shared.flinging or isRagdolled(getHumanoid()) then return end
        local myRoot=getRoot()
        local root=targetInfo(lockTarget)
        if myRoot and root then
            local flat=Vector3.new(root.Position.X,myRoot.Position.Y,root.Position.Z)
            if (flat-myRoot.Position).Magnitude>0.5 then
                myRoot.CFrame=CFrame.lookAt(myRoot.Position,flat)
            end
        end
    end)
    onCleanup(function()
        pcall(function() RunService:UnbindFromRenderStep("ChillhubLockOn") end)
        removeMarker()
        setAutoRotateLock("lockon",false)
    end)

